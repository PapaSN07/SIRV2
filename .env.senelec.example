# ── Profil SENELEC (bureau) — SQL Server srv-bddomtech ─────────────────────
# Usage :
#   cp .env.senelec.example .env.senelec
#   # éditer .env.senelec avec vos identifiants SQL
#   $env:SIR_PROFILE = "senelec"
#   cd sir-backend
#   alembic upgrade head
#
# Chez vous (Docker) : ne pas définir SIR_PROFILE, ou SIR_PROFILE=docker
#
# Docker + srv-bddomtech (réseau SENELEC) :
#   .\scripts\build-docker-senelec-env.ps1
#   make up-senelec
#   → API http://localhost:8000 · Frontend http://localhost:4210

# ── Base de données SQL Server SIRV2 (srv-bddomtech) ───────────────────────
# Option B — authentification SQL :
DATABASE_URL=mssql+aioodbc://VOTRE_USER:VOTRE_MOT_DE_PASSE@srv-bddomtech:1433/SIRV2?driver=ODBC+Driver+17+for+SQL+Server&TrustServerCertificate=yes

# Option A — authentification Windows (domaine electricite.sn) :
# DATABASE_URL=mssql+aioodbc://@srv-bddomtech/SIRV2?driver=ODBC+Driver+18+for+SQL+Server&Trusted_Connection=yes&TrustServerCertificate=yes

# ── Redis / Celery (local ou Docker, selon votre poste) ─────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── JWT ───────────────────────────────────────────────────────────────────────
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Application ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
API_VERSION=v1
CORS_ORIGINS=http://localhost:4210

# ── SMS / Email (mock dev) ────────────────────────────────────────────────────
# Passerelle SMS SENELEC (réseau interne) — chemin et format de requête à confirmer
SMS_GATEWAY_URL=http://10.101.2.86:8080
SMS_GATEWAY_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── LDAP / Active Directory (compte de service) ──────────────────────────────
# Compte : service.sip / UPN service.sip@electricite.sn
# DN réel AD : CN=service SIP,CN=Users,DC=electricite,DC=sn
# Mot de passe : uniquement dans .env.senelec (jamais dans git)
LDAP_ENABLED=true
LDAP_HOSTS=srv-siegedc0.electricite.sn,srv-siegedc2.electricite.sn,srv-datacentdc1.electricite.sn
LDAP_PORT=389
LDAP_USE_SSL=false
# Chiffrement recommandé : StartTLS sur 389 (ou LDAP_USE_SSL=true + LDAP_PORT=636)
LDAP_START_TLS=false
# Certificat PEM de l'autorité interne SENELEC (vide = magasin système)
LDAP_CA_CERT_FILE=
LDAP_BIND_DN=CN=service SIP,CN=Users,DC=electricite,DC=sn
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=DC=electricite,DC=sn
LDAP_USER_SEARCH_FILTER=(sAMAccountName={login})
LDAP_TIMEOUT_SECONDS=8
