# Base de données
DATABASE_URL=mssql+aiomssql://user:password@localhost:1433/SIR

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# App
ENVIRONMENT=development
API_VERSION=v1
CORS_ORIGINS=http://localhost:4200

# SMS Gateway (vide = mode mock dev — log sans envoi réseau)
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=

# Email (vide = mode mock dev — log sans envoi SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# LDAP / Active Directory (bureau SENELEC — voir .env.senelec.example)
LDAP_ENABLED=false
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=

# Rapports CRSE (Sprint 6)
RAPPORTS_STORAGE_PATH=./storage/rapports
RAPPORTS_FILE_TTL_HOURS=24
