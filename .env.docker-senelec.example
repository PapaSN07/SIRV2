# ── Docker + base SENELEC (srv-bddomtech) ────────────────────────────────────
# Généré automatiquement par : scripts/build-docker-senelec-env.ps1
# (à partir de .env.senelec — ne pas committer .env.docker-senelec)

# SQL Server corporate — driver 18 (image Docker api/worker)
DATABASE_URL=mssql+aioodbc://USER:PASS@srv-bddomtech:1433/SIRV2?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# Redis / Celery — noms de service Docker (pas localhost)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

ENVIRONMENT=development
API_VERSION=v1
CORS_ORIGINS=http://localhost:4210

# Passerelle SMS SENELEC : web service SOAP OSPWebService, méthode sendOneSignedSMS
SMS_GATEWAY_URL=http://10.101.2.86:8080
# WSDL du web service Orange SMS Pro
SMS_GATEWAY_WSDL=http://10.101.2.86:8080/OrangeSmsPro/OSPWebService?WSDL
# Signature (nom d'expéditeur) des SMS
SMS_GATEWAY_SIGNATURE=SENELEC
SMS_GATEWAY_API_KEY=
# Base clients SAIFI/SAIDI : BI_ODS (SRV-ASREPORTS), table CONTRATS_PAR_AGENCE_UR (SSIS).
# Compte SQL obligatoire depuis Docker (pas d'authentification Windows). Vide = dépôt Excel mensuel.
BI_ODS_ODBC=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

LDAP_ENABLED=true
LDAP_HOSTS=srv-siegedc0.electricite.sn,srv-siegedc2.electricite.sn,srv-datacentdc1.electricite.sn
LDAP_PORT=389
LDAP_USE_SSL=false
# Chiffrement recommandé : StartTLS sur 389 (ou LDAP_USE_SSL=true + LDAP_PORT=636)
LDAP_START_TLS=false
# Certificat PEM de l'autorité interne SENELEC (vide = magasin système)
LDAP_CA_CERT_FILE=
LDAP_BIND_DN=CN=service SIP,CN=Users,DC=electricite,DC=sn
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=DC=electricite,DC=sn
LDAP_USER_SEARCH_FILTER=(sAMAccountName={login})
LDAP_TIMEOUT_SECONDS=8
