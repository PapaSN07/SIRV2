# Migration HFSQL → SQL Server SIRV2
# Copier vers .env.migration (gitignored) et ajuster les valeurs.

# --- Source HFSQL Client/Serveur ---
HFSQL_DRIVER=HFSQL
HFSQL_SERVER=srv-hfsql
HFSQL_PORT=4900
HFSQL_USER=admin
HFSQL_PASSWORD=change-me
# Nom de la base sur le serveur HFSQL Client/Serveur
HFSQL_DATABASE=SIR_ALHDL
# Optionnel : DSN ODBC 64 bits (prioritaire si défini)
# HFSQL_DSN=SIR_HFSQL

# --- Cible SQL Server (via SIR_PROFILE) ---
SIR_PROFILE=senelec
# DATABASE_URL chargé depuis .env.senelec

# --- Paramètres migration ---
# Fenêtre interruptions (prioritaire sur CUTOFF_YEARS)
MIGRATION_DATE_FROM=2020-01-01
MIGRATION_DATE_TO=2026-12-31
MIGRATION_CUTOFF_YEARS=3
MIGRATION_DRY_RUN=true
MIGRATION_BATCH_SIZE=500
# Compte technique pour created_by_id orphelin
MIGRATION_SYSTEM_LOGIN=migration.system
# PosteInterruption : false = import séparé depuis ITD (recommandé)
MIGRATION_LOAD_POSTE_INTERRUPTIONS=false

# --- IndicateursTransportDistribution (PosteInterruption SAIFI/SAIDI) ---
ITD_DATABASE=IndicateursTransportDistribution
