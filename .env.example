# ── Base de données SQL Server ────────────────────────────────────────────────
# Profil docker (défaut, chez vous) — voir aussi .env.senelec.example pour le bureau SENELEC
DB_SA_PASSWORD=StrongPass_ChangeMeInProd!
DATABASE_URL=mssql+aioodbc://sa:StrongPass_ChangeMeInProd!@db:1433/SIR?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT ───────────────────────────────────────────────────────────────────────
# Générer avec : openssl rand -hex 32
SECRET_KEY=changeme_generate_with_openssl_rand_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
API_VERSION=v1
CORS_ORIGINS=http://localhost:4200

# ── SMS Gateway ───────────────────────────────────────────────────────────────
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=

# ── Email SMTP ────────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── LDAP / Active Directory (désactivé hors réseau SENELEC) ─────────────────
LDAP_ENABLED=false
LDAP_HOSTS=
LDAP_PORT=389
LDAP_USE_SSL=false
# Chiffrement recommandé : StartTLS sur 389 (ou LDAP_USE_SSL=true + LDAP_PORT=636)
LDAP_START_TLS=false
# Certificat PEM de l'autorité interne SENELEC (vide = magasin système)
LDAP_CA_CERT_FILE=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_BASE_DN=DC=electricite,DC=sn
LDAP_USER_SEARCH_FILTER=(sAMAccountName={login})
